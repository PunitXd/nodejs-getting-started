# Generated by Kairo for nodejs-getting-started. Node 24, npm.
# -slim (Debian, glibc): native modules such as sqlite3 have prebuilt binaries
# for it, so npm needs no compiler. On Alpine (musl) they compile and fail.
FROM node:24-slim

WORKDIR /app

COPY . .
RUN npm ci --omit=dev

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

CMD ["npm","start"]
